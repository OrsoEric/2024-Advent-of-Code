    s_id = str(i_id)
    n_length = len(s_id)
    for n_half in range(1, n_length // 2 + 1):
        if n_length % n_half != 0:
            continue
        s_pattern = s_id[:n_half]
        if s_pattern * (n_length // n_half) == s_id:
            return True
    return False

def solve(i_ranges: List[Tuple[int, int]]) -> int:
